# Which Frappe site the app talks to.
#
# EXPO_PUBLIC_* is inlined into the JavaScript bundle at build time, so only
# public values belong here. Anything secret would ship inside the .apk/.ipa and
# be readable by anyone who downloads it.
#
# Left unset, the app falls back to the live demo site, so a fresh clone runs
# without any .env at all.
EXPO_PUBLIC_FRAPPE_URL=https://demo.ovira.cloud
