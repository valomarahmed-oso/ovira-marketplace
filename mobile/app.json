{
  "expo": {
    "name": "أوفيرا",
    "slug": "ovira",
    "scheme": "ovira",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "cloud.ovira.app",
      "associatedDomains": ["applinks:demo.ovira.cloud"]
    },
    "android": {
      "package": "cloud.ovira.app",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#0E8BFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "//": "The storefront's product route is SINGULAR — /shop/product/<slug>. /shop/products is the listing. Claiming the plural meant a shared product link opened the browser instead of the app, which is the whole point of the filter.",
          "data": [
            { "scheme": "https", "host": "demo.ovira.cloud", "pathPrefix": "/shop/product/" },
            { "scheme": "https", "host": "demo.ovira.cloud", "pathPrefix": "/shop/category/" },
            { "scheme": "https", "host": "demo.ovira.cloud", "pathPrefix": "/shop/account/orders" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "//": "SPA, not prerendered. `static` renders every route on Node first, where there is no `window` — and this app's device stores (cart, guest orders, notification settings) are backed by AsyncStorage, which on web IS window.localStorage. That pass crashed with `ReferenceError: window is not defined` and took the dev server down with it. Prerendering also buys nothing here: every screen needs a live session and a live API, and the storefront already covers SEO.",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#0E8BFF",
          "defaultChannel": "orders"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "نستخدم الكاميرا عشان تمسح باركود المنتج وتلاقيه في المتجر.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "نستخدم التعرّف على الوجه عشان نقفل حسابك على تليفونك."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0E8BFF",
          "dark": { "backgroundColor": "#0A121F" }
        }
      ],
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "forcesRTL": true,
          "supportedLocales": ["ar", "en"]
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
