{
  "expo": {
    "name": "أوفيرا",
    "slug": "ovira",
    "scheme": "ovira",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "cloud.ovira.app",
      "associatedDomains": [
        "applinks:demo.ovira.cloud"
      ],
      "infoPlist": {
        "ExpoLocalization_supportsRTL": true,
        "ExpoLocalization_forcesRTL": true,
        "CFBundleLocalizations": [
          "ar",
          "en"
        ]
      }
    },
    "android": {
      "package": "cloud.ovira.app",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#0E8BFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "demo.ovira.cloud",
              "pathPrefix": "/shop/product/"
            },
            {
              "scheme": "https",
              "host": "demo.ovira.cloud",
              "pathPrefix": "/shop/products"
            },
            {
              "scheme": "https",
              "host": "demo.ovira.cloud",
              "pathPrefix": "/shop/category/"
            },
            {
              "scheme": "https",
              "host": "demo.ovira.cloud",
              "pathPrefix": "/shop/categories"
            },
            {
              "scheme": "https",
              "host": "demo.ovira.cloud",
              "pathPrefix": "/shop/deals"
            },
            {
              "scheme": "https",
              "host": "demo.ovira.cloud",
              "pathPrefix": "/shop/stores"
            },
            {
              "scheme": "https",
              "host": "demo.ovira.cloud",
              "pathPrefix": "/shop/store/"
            },
            {
              "scheme": "https",
              "host": "demo.ovira.cloud",
              "pathPrefix": "/shop/track"
            },
            {
              "scheme": "https",
              "host": "demo.ovira.cloud",
              "pathPrefix": "/shop/wishlist"
            },
            {
              "scheme": "https",
              "host": "demo.ovira.cloud",
              "pathPrefix": "/shop/compare"
            },
            {
              "scheme": "https",
              "host": "demo.ovira.cloud",
              "pathPrefix": "/shop/sell"
            },
            {
              "scheme": "https",
              "host": "demo.ovira.cloud",
              "pathPrefix": "/shop/about"
            },
            {
              "scheme": "https",
              "host": "demo.ovira.cloud",
              "pathPrefix": "/shop/careers"
            },
            {
              "scheme": "https",
              "host": "demo.ovira.cloud",
              "pathPrefix": "/shop/terms"
            },
            {
              "scheme": "https",
              "host": "demo.ovira.cloud",
              "pathPrefix": "/shop/privacy"
            },
            {
              "scheme": "https",
              "host": "demo.ovira.cloud",
              "pathPrefix": "/shop/account"
            },
            {
              "scheme": "https",
              "host": "demo.ovira.cloud",
              "pathPrefix": "/shop/vendor"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro",
      "//": "SPA, not prerendered. `static` renders every route on Node first, where there is no `window` — and this app's device stores (cart, guest orders, notification settings) are backed by AsyncStorage, which on web IS window.localStorage. That pass crashed with `ReferenceError: window is not defined` and took the dev server down with it. Prerendering also buys nothing here: every screen needs a live session and a live API, and the storefront already covers SEO.",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#0E8BFF",
          "defaultChannel": "orders"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "نستخدم الكاميرا عشان تمسح باركود المنتج وتلاقيه في المتجر.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "نحتاج الوصول لصورك عشان ترفع صور منتجاتك ومتجرك."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "نستخدم التعرّف على الوجه عشان نقفل حسابك على تليفونك."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0E8BFF",
          "dark": {
            "backgroundColor": "#0A121F"
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "forcesRTL": true,
          "supportedLocales": [
            "ar",
            "en"
          ]
        }
      ],
      "expo-image",
      "expo-font",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "//": "Not a secret — this id ships inside every build and only names the project. `getExpoPushTokenAsync` refuses to mint a token without it, which is why notifications stayed silent until it was set.",
        "projectId": "9d6f4fa0-a19c-451c-b568-a238a16e42e3"
      },
      "router": {}
    },
    "updates": {
      "url": "https://u.expo.dev/9d6f4fa0-a19c-451c-b568-a238a16e42e3"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "omaralsaads-team"
  }
}
